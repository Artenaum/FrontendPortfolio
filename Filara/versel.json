{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "src/{server/users.json,shared/db/FilaraDB.json}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/auth",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/auth/login", "destination": "/api/auth" },
    { "source": "/auth/register", "destination": "/api/auth" },
    { "source": "/api/(.*)", "destination": "/api/db" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
